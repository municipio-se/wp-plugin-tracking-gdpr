#: autoload/services.php
msgid ""
"Select which services your site is using. These will be displayed in the "
"cookie and tracking consent dialog. The plugin controls registered scripts, "
"embeds, and declared fetch or sendBeacon destinations; it is not a general "
"network firewall."
msgstr ""
"Välj vilka tjänster sajten använder. Dom visas i dialogrutan för kak- och "
"spårningssamtycke. Pluginet styr registrerade script, inbäddningar och "
"deklarerade mål för fetch eller sendBeacon. Det är inte en generell "
"nätverksbrandvägg."

#: autoload/content-iframes.php
#, php-format
msgid "This content cannot be displayed because you have not consented to cookies and sharing data with %s."
msgstr "Detta innehåll kan inte visas eftersom du inte samtyckt till kakor och delning av uppgifter med %s."

#: autoload/content-iframes.php
msgid "Change my settings"
msgstr "Ändra mina inställningar"

#: autoload/content-iframes.php
#, php-format
