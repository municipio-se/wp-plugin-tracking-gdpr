#. Plugin Name of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Tracking & GDPR"
msgstr "Whitespace Tracking & GDPR"

#. Description of the plugin
#: whitespace-tracking-gdpr.php
msgid ""
"Adds tracking for Matomo and a consent dialog for cookie law and GDPR "
"compliance."
msgstr ""
"Lägger till spårning för Matomo och en dialogruta för samtycke för "
"efterlevnad av cookie-lagstiftning och GDPR."

#. Author of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Dev"
msgstr "Whitespace Dev"

