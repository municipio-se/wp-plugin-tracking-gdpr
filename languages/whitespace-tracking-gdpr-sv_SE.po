#. Plugin Name of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Tracking & GDPR"
msgstr "Whitespace Tracking & GDPR"

#. Description of the plugin
#: whitespace-tracking-gdpr.php
msgid "Adds tracking for Matomo and cookie consent for GDPR compliance."
msgstr ""
"Lägger till spårning för Matomo och cookie-samtycke för GDPR-efterlevnad."

#. Author of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Dev"
msgstr "Whitespace Dev"

#: autoload/categories.php:6
msgctxt "Cookie Category Title"
msgid "Necessary"
msgstr "Nödvändiga"

#: autoload/categories.php:11
msgid "Necessary cookies are always allowed."
msgstr "Nödvändiga cookies är alltid tillåtna."

#: autoload/categories.php:18
msgctxt "Cookie Category Title"
msgid "Personalization"
msgstr "Personalisering"

#: autoload/categories.php:23
msgid ""
"Personalization services use cookies to remember your activity and "
"preferences to improve your experience."
msgstr ""
"Personaliseringstjänster använder cookies för att komma ihåg din aktivitet "
"och dina preferenser för att förbättra din upplevelse."

#: autoload/categories.php:29
msgctxt "Cookie Category Title"
msgid "Analytics"
msgstr "Statistik"

#: autoload/categories.php:34
msgid ""
"Analytics services use cookies to collect information about how visitors use "
"the website."
msgstr ""
"Statistiktjänster använder cookies för att samla in information om hur "
"besökare använder webbplatsen."

#: autoload/categories.php:51
msgctxt "Cookie Category Title"
msgid "Embedded"
msgstr "Inbäddat innehåll"

#: autoload/categories.php:56
msgid ""
"Cookies that are set by third parties when we embed content from different "
"services."
msgstr ""
"Cookies som sätts av tredje part när vi bäddar in innehåll från olika "
"tjänster."

#: autoload/categories.php:62
msgctxt "Cookie Category Title"
msgid "Uncategorized"
msgstr "Okategoriserade"

#: autoload/categories.php:67
msgid "These cookies have not been categorized yet."
msgstr "Dessa cookies har inte kategoriserats ännu."

