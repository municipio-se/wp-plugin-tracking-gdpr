#: autoload/services.php
msgid "YouTube embed domain"
msgstr "Domän för YouTube-inbäddningar"

#: autoload/services.php
msgid "Choose which YouTube domain this site uses. The nocookie domain does not guarantee that visitors are free from third-party tracking or other data sharing."
msgstr "Välj vilken YouTube-domän sajten använder. Nocookie-domänen garanterar inte att besökare slipper tredjepartsspårning eller annan datadelning."

#: autoload/services.php
msgid "Standard YouTube"
msgstr "YouTube standardläge"

#: autoload/services.php
msgid "YouTube privacy-enhanced mode"
msgstr "YouTube med förbättrad integritet"

#: autoload/services.php:342
msgid "Allow any embedded content"
msgstr "Tillåt allt inbäddat innehåll"

#: autoload/services.php:346
msgid ""
"⚠️ Warning: This could violate cookie law compliance. Only enable this if you "
"know what you are doing. Please report any missing services to the plugin "
"author."
msgstr ""
"⚠️ Varning: Detta kan bryta mot cookie-lagstiftningen. Aktivera endast detta "
"om du vet vad du gör. Rapportera eventuella saknade tjänster till plugin-"
"skaparen."

