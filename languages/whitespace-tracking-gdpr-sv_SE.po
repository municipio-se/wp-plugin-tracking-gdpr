#. Plugin Name of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Tracking & GDPR"
msgstr "Whitespace Tracking & GDPR"

#. Description of the plugin
#: whitespace-tracking-gdpr.php
msgid ""
"Adds tracking for Matomo and a consent dialog for cookie law and GDPR "
"compliance."
msgstr ""
"Lägger till spårning för Matomo och en dialogruta för samtycke för "
"efterlevnad av cookie-lagstiftning och GDPR."

#. Author of the plugin
#: whitespace-tracking-gdpr.php
msgid "Whitespace Dev"
msgstr "Whitespace Dev"

#: autoload/categories.php:6
msgctxt "Cookie Category Title"
msgid "Necessary"
msgstr "Nödvändiga"

#: autoload/categories.php:11
msgid "Necessary cookies are always allowed."
msgstr "Nödvändiga cookies är alltid tillåtna."

#: autoload/categories.php:18
msgctxt "Cookie Category Title"
msgid "Personalization"
msgstr "Personalisering"

#: autoload/categories.php:23
msgid ""
"Personalization services use cookies to remember your activity and "
"preferences to improve your experience."
msgstr ""
"Personaliseringstjänster använder cookies för att komma ihåg din aktivitet "
"och dina preferenser för att förbättra din upplevelse."

#: autoload/categories.php:29
msgctxt "Cookie Category Title"
msgid "Analytics"
msgstr "Statistik"

#: autoload/categories.php:34
msgid ""
"Analytics services use cookies to collect information about how visitors use "
"the website."
msgstr ""
"Statistiktjänster använder cookies för att samla in information om hur "
"besökare använder webbplatsen."

#: autoload/categories.php:51
msgctxt "Cookie Category Title"
msgid "Embedded"
msgstr "Inbäddat innehåll"

#: autoload/categories.php:56
msgid ""
"Cookies that are set by third parties when we embed content from different "
"services."
msgstr ""
"Cookies som sätts av tredje part när vi bäddar in innehåll från olika "
"tjänster."

#: autoload/categories.php:62
msgctxt "Cookie Category Title"
msgid "Uncategorized"
msgstr "Okategoriserade"

#: autoload/categories.php:67
msgid "These cookies have not been categorized yet."
msgstr "Dessa cookies har inte kategoriserats ännu."

#: autoload/consent-dialog.php:30
msgid "Other third-party services"
msgstr "Andra tjänster från tredje part"

#: autoload/consent-dialog.php:73 autoload/consent-dialog.php:106
msgctxt "Consent Modal Button Label"
msgid "Accept all"
msgstr "Acceptera alla"

#: autoload/consent-dialog.php:79 autoload/consent-dialog.php:112
msgctxt "Consent Modal Button Label"
msgid "Accept necessary"
msgstr "Acceptera nödvändiga"

#: autoload/consent-dialog.php:85
msgctxt "Consent Modal Button Label"
msgid "Customize your consent"
msgstr "Anpassa ditt samtycke"

#: autoload/consent-dialog.php:118
msgctxt "Consent Modal Button Label"
msgid "Save current choices"
msgstr "Spara aktuella val"

#: autoload/consent-dialog.php:124
msgctxt "Consent Modal Button Label"
msgid "Close cookie consent dialog"
msgstr "Stäng dialogrutan för cookie-samtycke"

#: autoload/consent-dialog.php:219
msgid "Text strings"
msgstr "Textsträngar"

#: autoload/consent-dialog.php:223
msgid "Consent dialog"
msgstr "Dialog om samtycke"

#: autoload/consent-dialog.php:229 autoload/consent-dialog.php:300
msgid "Title"
msgstr "Titel"

#: autoload/consent-dialog.php:232
msgctxt "Consent Modal Title"
msgid "We value your privacy"
msgstr "Vi värdesätter din integritet"

#: autoload/consent-dialog.php:240 autoload/consent-dialog.php:311
msgid "Description"
msgstr "Beskrivning"

#: autoload/consent-dialog.php:247
msgctxt "Consent Modal Description"
msgid ""
"We use cookies to improve your experience on our site. For more information, "
"please see our <a href='%1' target='_blank' rel='noopener'>Privacy Policy</a>."
msgstr ""
"Vi använder cookies för att förbättra din upplevelse på vår webbplats. För "
"mer information, se vår <a href='%1' target='_blank' "
"rel='noopener'>integritetspolicy</a>."

#: autoload/consent-dialog.php:254
msgctxt "Consent Modal Description"
msgid "We use cookies to improve your experience on our site."
msgstr "Vi använder cookies för att förbättra din upplevelse på vår webbplats."

#: autoload/consent-dialog.php:294
msgid "Preferences dialog"
msgstr "Dialogruta för preferenser"

#: autoload/consent-dialog.php:303
msgctxt "Consent Modal Title"
msgid "Customize your consent"
msgstr "Anpassa ditt samtycke"

#: autoload/consent-dialog.php:318
msgctxt "Consent Modal Description"
msgid ""
"You can manage your cookie preferences here. For more information, please see "
"our <a href='%1' target='_blank' rel='noopener'>Privacy Policy</a>."
msgstr ""
"Du kan hantera dina cookiepreferenser här. För mer information, se vår <a "
"href='%1' target='_blank' rel='noopener'>integritetspolicy</a>."

#: autoload/consent-dialog.php:325
msgctxt "Consent Modal Description"
msgid "You can manage your cookie preferences here."
msgstr "Du kan hantera dina cookiepreferenser här."

#: autoload/consent-dialog.php:367 autoload/consent-dialog.php:374
msgid "Change cookie preferences"
msgstr "Ändra inställningar för cookies"

#. translators: 1: URL to set the page for privacy policy
#: autoload/consent-dialog.php:465
#, php-format
msgid ""
"To ensure compliance with GDPR and the cookie law, please <a "
"href=\"%1$s\">set a page for your privacy policy</a>."
msgstr ""
"För att säkerställa efterlevnad av GDPR och cookie-lagen bör du ange <a "
"href=\"%1$s\">en sida för din integritetspolicy</a>."

#: autoload/csp.php:66
msgid "Content Security Policy"
msgstr "Content Security Policy"

#: autoload/csp.php:71
msgid "Allowed iframe hosts (for the CSP “frame-src” directive)"
msgstr "Tillåtna iframe-värdar (för CSP-direktivet ”frame-src”)"

#: autoload/csp.php:75
msgid ""
"One per line. ⚠️ Warning: This will allow any iframe from the specified "
"sources, including potentially harmful ones."
msgstr ""
"En per rad. ⚠️ Varning: Detta kommer att tillåta alla iframes från de angivna "
"källorna, inklusive potentiellt skadliga sådana."

#: autoload/matomo-settings.php:6
msgctxt "Options Page Title"
msgid "Tracking"
msgstr "Spårning"

#: autoload/matomo-settings.php:11
msgctxt "Options Page Menu Title"
msgid "Tracking"
msgstr "Spårning"

#: autoload/matomo-settings.php:24
msgid "Matomo"
msgstr "Matomo"

#: autoload/matomo-settings.php:28
msgid "URL"
msgstr "URL"

#: autoload/matomo-settings.php:31
msgid "The URL for the Matomo Tag Manager."
msgstr "URL:en för Matomo Tag Manager."

#: autoload/matomo-settings.php:39
msgid "Container ID"
msgstr "Container-ID"

#: autoload/matomo-settings.php:50
msgid "Site ID"
msgstr "Webbplats-ID"

#: autoload/matomo-settings.php:53
msgid "The site ID for the Matomo Tag Manager."
msgstr "Webbplats-ID för Matomo Tag Manager."

#. Translators: This message is shown when a field is disabled because its value is defined as a constant in the code.
#: autoload/matomo-settings.php:87
#, php-format
msgid "This field is disabled because the constant %s has been defined in code."
msgstr "Detta fält är inaktiverat eftersom konstanten %s har definierats i kod."

#: autoload/services.php:260
msgctxt "Service Sub Field Label"
msgid "Enabled"
msgstr "Aktiverad"

#: autoload/services.php:322
msgid "Services"
msgstr "Tjänster"

#: autoload/services.php:327
msgid "Enabled services and settings"
msgstr "Aktiverade tjänster och inställningar"

#: autoload/services.php:331
msgid ""
"Select which services your site is using. These will be displayed in the "
"cookie and tracking consent dialog."
msgstr ""
"Välj vilka tjänster din webbplats använder. Dessa kommer att visas i "
"dialogrutan för cookie- och spårningssamtycke."

#: autoload/services.php:342
msgid "Allow any embedded content"
msgstr "Tillåt allt inbäddat innehåll"

#: autoload/services.php:346
msgid ""
"⚠️ Warning: This could violate cookie law compliance. Only enable this if you "
"know what you are doing. Please report any missing services to the plugin "
"author."
msgstr ""
"⚠️ Varning: Detta kan bryta mot cookie-lagstiftningen. Aktivera endast detta "
"om du vet vad du gör. Rapportera eventuella saknade tjänster till plugin-"
"skaparen."
